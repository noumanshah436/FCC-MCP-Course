{
    "mcpServers": {
        "Calculator-STDIO": {
            "command": "venv/Scripts/python.exe",
            "args": [
                "MainCode/Scenario1/fastmcp_calculator.py"
            ]
        },
        "Calculator-HTTP": {
            "command": "npx",
            "args": [
